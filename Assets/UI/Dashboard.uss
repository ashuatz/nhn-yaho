/* 진단 대시보드 스타일 (UI Toolkit).
   구 IMGUI 대시보드를 대체한다 - 색/여백은 여기서만 만진다 (코드는 수치와 표시 여부만).
   폰트는 지정하지 않는다: HudView가 루트에 넣은 내장 동적 폰트를 상속받는다
   (USS의 resource(...) 폰트는 런타임 패널에서 해석되지 않아 글자가 사라진다). */

.dash-root {
    position: absolute;
    left: 12px;
    top: 92px;
    width: 268px;
}

/* -- 헤더 (접기 토글) --------------------------------------------------- */

.dash-header {
    flex-direction: row;
    align-items: center;
    height: 24px;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(8, 10, 14, 0.82);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(233, 196, 106, 0.45);
    border-right-color: rgba(233, 196, 106, 0.45);
    border-top-color: rgba(233, 196, 106, 0.45);
    border-bottom-color: rgba(233, 196, 106, 0.45);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.dash-header:hover {
    background-color: rgba(18, 22, 28, 0.9);
}

.dash-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(233, 196, 106);
}

/* 접힌 상태에서도 핵심 수치는 보인다 - 펼치지 않고 상태를 훑기 위한 줄 */
.dash-summary {
    flex-grow: 1;
    margin-left: 8px;
    font-size: 11px;
    color: rgb(150, 160, 175);
    overflow: hidden;
}

.dash-fold {
    font-size: 11px;
    color: rgb(150, 160, 175);
}

/* -- 본문 --------------------------------------------------------------- */

.dash-body {
    margin-top: 3px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 6px;
    background-color: rgba(8, 10, 14, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(150, 160, 175, 0.3);
    border-right-color: rgba(150, 160, 175, 0.3);
    border-top-color: rgba(150, 160, 175, 0.3);
    border-bottom-color: rgba(150, 160, 175, 0.3);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.dash-section {
    margin-bottom: 5px;
}

.dash-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(120, 175, 165);
    margin-bottom: 1px;
}

.dash-row {
    flex-direction: row;
    align-items: center;
    height: 16px;
}

.dash-key {
    width: 92px;
    font-size: 11px;
    color: rgb(140, 150, 165);
}

.dash-value {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(226, 230, 236);
    -unity-text-align: middle-right;
}

/* 진행도 등 0..1 값은 숫자 대신 막대로 - 훑을 때 눈에 먼저 들어온다 */
.dash-meter {
    flex-grow: 1;
    height: 12px;
    background-color: rgba(40, 46, 56, 0.9);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    justify-content: center;
}

.dash-meter-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: rgba(42, 157, 143, 0.75);
}

.dash-meter-text {
    font-size: 10px;
    -unity-text-align: middle-center;
    color: rgb(226, 230, 236);
}

/* 위험 수치 (붕괴 임박 등) */
.dash-value--alert {
    color: rgb(240, 130, 120);
    -unity-font-style: bold;
}

.dash-hint {
    margin-top: 2px;
    font-size: 10px;
    color: rgb(110, 118, 132);
}
