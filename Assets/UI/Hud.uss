/* 그레이박스 HUD 스타일 (UI Toolkit).
   uGUI HudCanvas를 대체한다 - 색/여백은 여기서만 만진다 (코드는 수치만 넣는다). */

/* 폰트는 USS에서 지정하지 않는다 (HudView가 코드로 넣는다).
   resource("LegacyRuntime.ttf")는 런타임 패널에서 해석되지 않아 폰트가 null이 되고,
   기본 런타임 테마 폰트는 한글 글리프가 없다 - 내장 동적 폰트(OS 폴백)가 필요하다. */
.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 18px;
    color: rgb(232, 232, 226);
}

/* 공통 패널 - 반투명 검정 + 얇은 외곽선 */
.panel {
    background-color: rgba(8, 10, 14, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(150, 160, 175, 0.35);
    border-right-color: rgba(150, 160, 175, 0.35);
    border-top-color: rgba(150, 160, 175, 0.35);
    border-bottom-color: rgba(150, 160, 175, 0.35);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* -- 피격 플래시 ------------------------------------------------------- */

.damage-flash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(200, 40, 30, 1);
    opacity: 0;
}

/* -- 월드 라벨 -------------------------------------------------------- */

.label-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.world-label {
    position: absolute;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: 13px;
    color: rgb(226, 230, 236);
    background-color: rgba(8, 10, 14, 0.66);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    -unity-text-align: middle-center;
}

/* -- 상단 중앙: 타이머 / 안내 ----------------------------------------- */

.top-center {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    align-items: center;
}

.timer-box {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-left-color: rgba(233, 196, 106, 0.8);
    border-right-color: rgba(233, 196, 106, 0.8);
    border-top-color: rgba(233, 196, 106, 0.8);
    border-bottom-color: rgba(233, 196, 106, 0.8);
}

.timer-text {
    font-size: 30px;
    color: rgb(233, 196, 106);
    -unity-font-style: bold;
}

.announce-text {
    margin-top: 8px;
    font-size: 20px;
    color: rgb(226, 230, 236);
    -unity-font-style: bold;
    display: none;
}

.warning-text {
    margin-top: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: 17px;
    color: rgb(255, 208, 208);
    background-color: rgba(160, 40, 30, 0.78);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    display: none;
}

/* -- 좌상단: 체력 / 무게 바 ------------------------------------------- */

.top-left {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 240px;
}

.bar {
    height: 26px;
    margin-bottom: 6px;
    justify-content: center;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.health-fill {
    background-color: rgba(224, 69, 61, 0.85);
}

.load-fill {
    background-color: rgba(217, 217, 204, 0.8);
}

.bar-text {
    -unity-text-align: middle-center;
    font-size: 15px;
    color: rgb(20, 22, 26);
    -unity-font-style: bold;
}

/* -- 우상단: 수집 요약 ------------------------------------------------ */

.top-right {
    position: absolute;
    top: 12px;
    right: 12px;
    align-items: flex-end;
}

.objective-box {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    align-items: flex-end;
}

.objective-title {
    font-size: 14px;
    color: rgb(160, 170, 185);
}

.objective-text {
    font-size: 17px;
    -unity-font-style: bold;
}

/* -- 좌하단: 조이스틱 ------------------------------------------------- */

.joystick-base {
    position: absolute;
    left: 28px;
    bottom: 28px;
    width: 128px;
    height: 128px;
    background-color: rgba(230, 235, 240, 0.16);
    border-top-left-radius: 64px;
    border-top-right-radius: 64px;
    border-bottom-left-radius: 64px;
    border-bottom-right-radius: 64px;
    justify-content: center;
    align-items: center;
}

.joystick-knob {
    width: 54px;
    height: 54px;
    background-color: rgba(235, 240, 245, 0.62);
    border-top-left-radius: 27px;
    border-top-right-radius: 27px;
    border-bottom-left-radius: 27px;
    border-bottom-right-radius: 27px;
}

/* -- 하단 중앙: 루팅 게이지 ------------------------------------------- */

.bottom-center {
    position: absolute;
    bottom: 96px;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}

.gauge {
    width: 260px;
    height: 22px;
    justify-content: center;
}

.gauge-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: rgba(233, 196, 106, 0.85);
}

.gauge-text {
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgb(20, 22, 26);
    -unity-font-style: bold;
}

/* -- 우하단: 가방 / 상호작용 ------------------------------------------ */

.bottom-right {
    position: absolute;
    right: 12px;
    bottom: 12px;
    align-items: flex-end;
}

.bag-panel {
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 8px;
    align-items: flex-end;
}

.bag-weight {
    font-size: 14px;
    color: rgb(233, 196, 106);
    margin-bottom: 4px;
}

.bag-slots {
    flex-direction: row;
}

.bag-slot {
    width: 44px;
    height: 44px;
    margin-left: 4px;
    background-color: rgba(28, 32, 40, 0.9);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(120, 130, 145, 0.45);
    border-right-color: rgba(120, 130, 145, 0.45);
    border-top-color: rgba(120, 130, 145, 0.45);
    border-bottom-color: rgba(120, 130, 145, 0.45);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    justify-content: flex-end;
    align-items: flex-end;
}

.bag-slot--locked {
    background-color: rgba(18, 20, 24, 0.6);
    border-left-color: rgba(90, 95, 105, 0.25);
    border-right-color: rgba(90, 95, 105, 0.25);
    border-top-color: rgba(90, 95, 105, 0.25);
    border-bottom-color: rgba(90, 95, 105, 0.25);
}

.bag-slot-icon {
    position: absolute;
    left: 8px;
    top: 8px;
    right: 8px;
    bottom: 8px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.bag-slot-count {
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 3px;
    margin-bottom: 1px;
}

.bag-slot-mark {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 8px;
    height: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.interact-button {
    margin-top: 8px;
    margin-left: 0;
    margin-right: 0;
    min-width: 148px;
    height: 46px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(232, 232, 226);
    background-color: rgba(42, 157, 143, 0.85);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    display: none;
}

.interact-button:hover {
    background-color: rgba(52, 177, 163, 0.9);
}

.interact-button:active {
    background-color: rgba(32, 127, 116, 0.95);
}

/* -- 결과 패널 -------------------------------------------------------- */

.result-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 8, 12, 0.78);
    justify-content: center;
    align-items: center;
    display: none;
}

.result-title {
    font-size: 40px;
    -unity-font-style: bold;
}

.result-body {
    margin-top: 10px;
    font-size: 20px;
}

.result-hint {
    margin-top: 24px;
    font-size: 16px;
    color: rgb(160, 170, 185);
}
